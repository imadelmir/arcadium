# Template di configurazione del backend Spring Boot.
# Copiare in ".env" (non versionato) e valorizzare, oppure esportare queste
# variabili nell'ambiente prima di avviare l'app.
# Le chiavi sono le stesse dell'ETL (etl/config/.env.example): un solo set di
# credenziali per lo stesso database Arcadium.

# --- Connessione a PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcadium
DB_USER=arcadium
DB_PASSWORD=ACE_5

# --- Server HTTP ---
SERVER_PORT=8080

# --- Percorsi delle migrazioni condivise (override, opzionale) ---
# Default relativi a backend/ ; da impostare solo se si avvia da un'altra
# working directory o in un ambiente con layout diverso.
# ARCADIUM_DB_MIGRATIONS=../database/migrations
# ARCADIUM_DB_SEED=../database/seed
