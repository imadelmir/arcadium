<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         Arcadium — ACE5 · Milestone M4 · Backend Spring Boot
         Setup in M4-T1; entità/repository in M4-T2; sicurezza JWT in M4-T3.

         Le versioni delle dipendenze Spring non sono fissate a mano: le governa
         il BOM di spring-boot-starter-parent. jjwt non è gestito dal BOM, quindi
         la sua versione è indicata esplicitamente.
         ===================================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>       <!-- GA corrente (giu 2026); la linea 3.5 e' EOL dal 30 giu 2026 -->
        <relativePath/>
    </parent>

    <groupId>com.ace5</groupId>
    <artifactId>arcadium-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>arcadium-backend</name>
    <description>Backend Spring Boot della piattaforma Arcadium (M4)</description>

    <properties>
        <java.version>21</java.version>   <!-- LTS; Spring Boot 4.1 supporta Java 17-26 -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- springdoc-openapi: la linea 3.0.x e' quella per Spring Boot 4 / Spring 7
             (la 2.x e' per Boot 3). Non gestita dal BOM Spring: versione a mano. -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- BOM di Testcontainers (M6-T4, BUG D): allinea le versioni dei
             moduli org.testcontainers:* (junit-jupiter, postgresql) con quella
             che spring-boot-testcontainers usa internamente. Il BOM di Spring
             gestisce spring-boot-testcontainers ma NON i moduli Testcontainers
             "puri": senza questo import, Maven non trova la loro versione. -->
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST: base per gli endpoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate + datasource HikariCP: entita' e repository (M4-T2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: DTO di registrazione/login (M4-T3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security: autenticazione JWT, filtro e password encoding (M4-T3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Documentazione API OpenAPI + Swagger UI (M4-T12).
             Genera /v3/api-docs e /swagger-ui.html esaminando i controller. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>


        <!-- JWT (jjwt): emissione e verifica dei token. api a compile-time,
             impl e jackson a runtime. Versione non gestita dal BOM Spring. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator: /actuator/health (pubblico), dettagli solo se autorizzati. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Flyway: esegue all'avvio le STESSE migrazioni M2/M3
             (database/migrations + database/seed), condividendo la history
             flyway_schema_history gia' presente nel DB. Vedi database/README.md.

             NOTA (Spring Boot 4): la sola libreria flyway-core NON basta piu'.
             Boot 4 ha modularizzato le auto-configurazioni: la classe
             FlywayAutoConfiguration vive nel modulo spring-boot-flyway, che
             arriva solo con lo starter. Senza starter, Flyway resta sul
             classpath ma non viene MAI eseguito all'avvio (nessun log, nessuna
             migrazione applicata) e Hibernate fallisce la validazione dello
             schema. Lo starter porta flyway-core in transitiva: non va aggiunto
             una seconda volta.

             flyway-database-postgresql resta necessario: contiene il supporto
             specifico per il dialetto PostgreSQL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Driver PostgreSQL 16 (a runtime). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test: JUnit 5, Mockito, Spring Test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test di sicurezza (mock user, ecc.). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (M6-T4, BUG D): il context smoke test (contextLoads)
             avvia un PostgreSQL reale ma EFFIMERO in un container invece di
             richiedere un DB gia' in ascolto. Flyway applica le stesse migrazioni
             e seed sul container: cosi' "mvn test"/CI non dipendono piu' da un
             Postgres esterno. Versioni allineate dal testcontainers-bom sopra. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Copia le migrazioni e i seed del DB (sorgente in ../database) nel
                 classpath (target/classes/db/...) durante la build. Serve al jar
                 impacchettato: nel profilo "prod" Flyway le legge via
                 classpath:db/migration e classpath:db/seed, perche' nel jar i
                 percorsi filesystem "../database/..." non esistono piu'.
                 In sviluppo NON incide: il profilo default continua a leggere da
                 filesystem, quindi la copia e' solo un di piu' innocuo. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-db-scripts-to-classpath</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../database/migrations</directory>
                                    <targetPath>migration</targetPath>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>**/*.sql</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../database/seed</directory>
                                    <targetPath>seed</targetPath>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>**/*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
